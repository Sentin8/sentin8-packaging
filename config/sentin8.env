# Sentin8 platform configuration — FHS layout (Debian package).
# Installed to /etc/sentin8/sentin8.env, read by the systemd unit via
# EnvironmentFile. See sentin8/design/sentin8-debian-packaging-design.md §7.
#
# PostgreSQL 18 and Valkey are external URL-addressed dependencies — change
# these URLs to point at remote hosts if not running locally.

# ── Platform ──────────────────────────────────────────────────────────
SENTIN8_DOMAIN=sentin8.local
SENTIN8_BASE_PORT=8000

# ── FHS paths (defaults — these match sentin8-config crate defaults) ───
# SENTIN8_CONFIG_DIR=/etc/sentin8
# SENTIN8_STATE_DIR=/var/lib/sentin8
# SENTIN8_LOG_DIR=/var/log/sentin8
# SENTIN8_RUN_DIR=/run/sentin8

# ── Binary resolution ─────────────────────────────────────────────────
# Production: binaries are in /usr/bin (installed by the sentin8 package).
# Vertical binaries (bank8-ledger, etc.) are also in /usr/bin.
SENTIN8_CAPTAIN_BINARY_PREFIX=/usr/bin

# ── External dependencies (URL-addressed) ─────────────────────────────
# F1 (§4.3e): shared DSN uses the NOBYPASSRLS `sentin8_app` role so RLS
# enforces at runtime. Per-service DSNs (SENTIN8_AUTH_DB_DSN,
# BANK8_LEDGER_DATABASE_URL, ...) resolve to that service's own PG role
# created by `vertical enroll`. The `sentin8` superuser is DDL-only.
DATABASE_URL=postgres://sentin8_app:sentin8@localhost:5432/sentin8
VALKEY_URL=valkeys://localhost:6379/0

# ── Sentin8:Auth ──────────────────────────────────────────────────────
SENTIN8_AUTH_ISSUER=https://sentin8-auth.ops.sys.sentin8.local

# ── Captain ──────────────────────────────────────────────────────────
# SENTIN8_CAPTAIN_LOCAL_IP=  # auto-detected if unset
# SENTIN8_CAPTAIN_CATALOG_PATHS=/usr/share/bank8/catalog.json,/usr/share/hotel8/catalog.json