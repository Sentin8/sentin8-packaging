[Unit]
Description=Sentin8 platform supervisor
Documentation=https://github.com/Sentin8/sentin8
After=network-online.target
Wants=network-online.target postgresql.service valkey-server.service
# Wants (not Requires) so that remote DB/Valkey hosting does not block
# local startup. PostgreSQL 18 and Valkey are URL-addressed dependencies.

[Service]
Type=simple
EnvironmentFile=/etc/sentin8/sentin8.env
ExecStart=/usr/bin/sentin8-cli captain start
ExecStop=/usr/bin/sentin8-cli captain stop
Restart=on-failure
RestartSec=5s
User=sentin8
Group=sentin8

# Ingress bind privilege (PORTBIND-1).
# The only low-port listener on a fleet machine is sentin8-proxy (:443,
# plus :80 when the ACME HTTP-01 listener is enabled). It runs as the
# unprivileged sentin8 user, so the capability is granted HERE and
# inherited across captain's fork+exec of the proxy child.
#
# Ambient (not file) capabilities are the mechanism: NoNewPrivileges=yes
# makes a `setcap` xattr inert at execve (prctl(2): file capabilities do
# not add to the permitted set when no_new_privs is set), ProtectSystem=full
# would prevent applying one at runtime, and dpkg upgrades replace the
# binary inode. The bounding set is required because ambient capabilities
# must also be within it; narrowing it to this single capability also
# reduces exposure versus the unrestricted default.
# Design: sentin8-packaging/DESIGN.md §4.1.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

# Private tmp and protect system to harden the service.
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
NoNewPrivileges=yes

# FHS paths owned by the sentin8 user.
RuntimeDirectory=sentin8
StateDirectory=sentin8
LogsDirectory=sentin8

[Install]
WantedBy=multi-user.target